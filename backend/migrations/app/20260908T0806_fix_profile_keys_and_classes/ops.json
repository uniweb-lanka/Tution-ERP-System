        "sql": "CREATE TABLE \"public\".\"class\" (\n  \"capacity\" int4,\n  \"code\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"deliveryMode\" text DEFAULT 'physical' NOT NULL,\n  \"endsAt\" timestamptz,\n  \"gradeId\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"instituteId\" text NOT NULL,\n  \"monthlyFee\" numeric,\n  \"name\" text NOT NULL,\n  \"startsAt\" timestamptz,\n  \"status\" text DEFAULT 'draft' NOT NULL,\n  \"streamId\" text,\n  \"subjectId\" text NOT NULL,\n  \"teacherId\" text NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"class_deliveryMode_check_338a3585\" CHECK (\"deliveryMode\" IN ('physical', 'online', 'hybrid')),\n  CONSTRAINT \"class_status_check_27abb986\" CHECK (\"status\" IN ('draft', 'active', 'completed', 'cancelled', 'archived'))\n)",
        "params": []
      }
    ],
