      {
        "description": "create table \"enrollment\"",
        "sql": "CREATE TABLE \"public\".\"enrollment\" (\n  \"classId\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"endedAt\" timestamptz,\n  \"enrolledAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" text NOT NULL,\n  \"instituteId\" text NOT NULL,\n  \"notes\" text,\n  \"status\" text DEFAULT 'active' NOT NULL,\n  \"studentId\" text NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"enrollment_status_check_08674715\" CHECK (\"status\" IN ('active', 'paused', 'completed', 'cancelled'))\n)",
        "params": []
      }
    ],
